# Required for LLM Generation via OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: For OpenAI, Groq, or Gemini LLM / transcription providers
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Instagram login is NOT required for scraping public profiles!
# Only provide a burner account here if you scrape heavily and encounter rate limits.
# INSTAGRAM_USERNAME=your_ig_username_here
# INSTAGRAM_PASSWORD=your_ig_password_here